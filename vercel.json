{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": ".",
        "framework": "nextjs",
        "bindings": [
            {"type": "service", "service": "backend", "format": "url", "env": "BACKEND_INTERNAL_URL"}
        ]
      },
      "backend": {
        "root": "app/backend",
        "framework": "fastapi",
        "entrypoint": "main.py"
      }
    },
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": {
          "service": "app"
        }
      }
    ]
  }